# ==========================================
# Project Management System - Production Environment Configuration
# ==========================================

# Core Django Configuration
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate_a_cryptographically_secure_random_key_min_50_chars
DJANGO_ALLOWED_HOSTS=pms.example.com,api.example.com

# Production Database (PostgreSQL / MySQL)
DJANGO_DB_ENGINE=postgresql
DJANGO_DB_NAME=pms_production
DJANGO_DB_USER=pms_app_user
DJANGO_DB_PASSWORD=your_production_db_password_here
DJANGO_DB_HOST=db.production.internal
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=600

# Security & SSL Settings
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1

# Email Service (SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.sendgrid.net
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=apikey
DJANGO_EMAIL_HOST_PASSWORD=your_sendgrid_api_key_here
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=no-reply@pms.example.com

# Storage Limits
TASK_ATTACHMENT_MAX_SIZE_BYTES=10485760
